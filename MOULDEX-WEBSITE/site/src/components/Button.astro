---
interface Props {
  href: string;
  variant?: 'primary' | 'accent' | 'ghost';
  arrow?: boolean;
  class?: string;
  target?: string;
  rel?: string;
}
const { href, variant = 'primary', arrow = true, class: className = '', target, rel } = Astro.props;
const classes = ['btn', variant !== 'primary' ? `btn--${variant}` : '', className]
  .filter(Boolean)
  .join(' ');
---
<a href={href} class={classes} target={target} rel={rel}>
  <span><slot /></span>
  {
    arrow && (
      <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 12h15" />
        <path d="M13 6l6 6-6 6" />
      </svg>
    )
  }
</a>
