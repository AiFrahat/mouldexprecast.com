---
/** Inline stroke icons. All are decorative: the accessible name comes from context. */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  arrow: '<path d="M4 12h15"/><path d="M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  phone:
    '<path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 4.5 5.7 2 2 0 0 1 6.5 3.5Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14"/><path d="m3.5 6.5 8.5 6 8.5-6"/>',
  fax: '<path d="M7 8V4h10v4"/><rect x="4" y="8" width="16" height="8"/><path d="M8 16h8v4H8z"/><path d="M17 11h.01"/>',
  pin: '<path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.6 3.8 5.6 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/>',
  menu: '<path d="M3 6h18"/><path d="M3 12h18"/><path d="M3 18h18"/>',
  close: '<path d="M5 5l14 14"/><path d="M19 5 5 19"/>',
  'chevron-down': '<path d="m5 9 7 7 7-7"/>',
  check: '<path d="m4 12.5 5 5L20 6.5"/>',
  layers:
    '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12.5 9 5 9-5"/><path d="M3 17l9 5 9-5"/>',
  frame:
    '<path d="M4 21V7l8-4 8 4v14"/><path d="M4 12h16"/><path d="M12 3v18"/><path d="M8 21v-5h8v5"/>',
  house:
    '<path d="m3 11 9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
  slab:
    '<rect x="3" y="6" width="18" height="12"/><circle cx="8" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="16" cy="12" r="1.2"/>',
  wall: '<path d="M3 9h18"/><path d="M3 15h18"/><path d="M3 4v16"/><path d="M21 4v16"/><path d="M9 9v6"/><path d="M15 9v6"/>',
  sealant:
    '<path d="M9 3h6v4H9z"/><path d="M9 7 7 11v9h10v-9l-2-4"/><path d="M12 14v3"/>',
};
const markup = icons[name] ?? icons.arrow;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>
