---
import { site } from '../lib/content';
import { pick, langFromPathname, isRtl } from '../lib/i18n';
import type { Lang } from '../lib/types';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Route path without the locale prefix, e.g. '' or 'services/precast-claddings'. */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  fullTitle?: boolean;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  path,
  image = '/og-image.jpg',
  type = 'website',
  fullTitle = false,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://mouldexprecast.com');
const clean = path.replace(/^\/+|\/+$/g, '');
const localized = clean ? `/${lang}/${clean}/` : `/${lang}/`;
const canonical = new URL(localized, siteUrl).href;
const other = lang === 'en' ? 'ar' : 'en';
const otherUrl = new URL(clean ? `/${other}/${clean}/` : `/${other}/`, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const pageTitle = fullTitle ? title : `${title} | ${pick(site.brand.name, lang)}`;
const dir = isRtl(lang) ? 'rtl' : 'ltr';
const brandName = pick(site.brand.name, lang);
const orgDescription = pick(site.brand.shortDescription, lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand.legalName.en,
  alternateName: site.brand.name.en,
  url: new URL('/', siteUrl).href,
  logo: new URL('/brand/mouldex-logo-full.png', siteUrl).href,
  description: site.brand.shortDescription.en,
  telephone: site.contact.phoneHref,
  faxNumber: site.contact.faxIntl.replace(/\s+/g, ''),
  email: site.contact.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Dubai',
    addressCountry: 'AE',
    postOfficeBoxNumber: site.contact.poBox,
  },
  areaServed: { '@type': 'Country', name: 'United Arab Emirates' },
  knowsLanguage: ['en', 'ar'],
};

const activeLang = langFromPathname(Astro.url.pathname);
if (activeLang !== lang) {
  // Defensive: a page rendered for the wrong locale should never ship.
  throw new Error(`BaseLayout locale mismatch: ${activeLang} !== ${lang}`);
}
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06182f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(clean ? `/en/${clean}/` : '/en/', siteUrl).href} />
    <link rel="alternate" hreflang="ar" href={new URL(clean ? `/ar/${clean}/` : '/ar/', siteUrl).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(clean ? `/en/${clean}/` : '/en/', siteUrl).href} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AE' : 'en_AE'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_AE' : 'ar_AE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" href={otherUrl} hreflang={other} />

    <link rel="preload" href="/fonts/archivo-latin-100900.woff2" as="font" type="font/woff2" crossorigin />
    {
      lang === 'ar' && (
        <link
          rel="preload"
          href="/fonts/ibm-plex-sans-arabic-arabic-400.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="page" data-lang={lang}>
    <a class="skip-link" href="#main">{pick(site.ui.skipToContent, lang)}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
